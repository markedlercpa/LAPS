// LAPS — Sales Cycle Management
// Prisma schema. Postgres in production (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — Account holds the M365/Graph OAuth tokens
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  REP
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(REP)
  hubspotOwnerId String?   @unique
  createdAt      DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // Ownership relations across the LAPS pipeline
  leads        Lead[]         @relation("LeadOwner")
  appointments Appointment[]  @relation("AppointmentOwner")
  proposals    Proposal[]     @relation("ProposalOwner")
  activities   Activity[]
  actionItems  ActionItem[]   @relation("ActionItemAssignee")
  bookingHost  BookingHost?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// LAPS pipeline
// ---------------------------------------------------------------------------

enum Stage {
  NEW
  APPOINTMENT
  PROPOSAL
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id          String   @id @default(cuid())
  hubspotId   String?  @unique
  firstName   String
  lastName    String
  companyName String?
  leadSource  String?
  email       String?
  phone       String?
  stage       Stage    @default(NEW)
  lostReason  String?
  notes       String?  @db.Text
  trustScore  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  activities   Activity[]
  appointments Appointment[]
  proposals    Proposal[]
  actionItems  ActionItem[]
  trustSignals TrustSignal[]

  @@index([stage])
  @@index([ownerId])
}

enum ActivityType {
  EMAIL_SENT
  EMAIL_RECEIVED
  TEXT
  CALL
  NOTE
  MEETING
  OTHER
}

enum Direction {
  IN
  OUT
}

model Activity {
  id         String       @id @default(cuid())
  leadId     String
  userId     String?
  type       ActivityType
  direction  Direction    @default(OUT)
  subject    String?
  body       String?      @db.Text
  occurredAt DateTime     @default(now())
  metadata   Json?

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([type])
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  NO_SHOW
  CANCELED
}

model Appointment {
  id          String            @id @default(cuid())
  leadId      String
  ownerId     String?
  title       String
  scheduledAt DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(BOOKED)
  graphEventId String?          @unique
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())

  // Self-serve booking fields (populated when booked via a public /book page).
  eventTypeId     String?
  eventType       BookingEventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  inviteeName     String?
  inviteeEmail    String?
  inviteePhone    String?
  timezone        String?
  location        String?
  meetingUrl      String?
  answers         Json? // screening question answers
  rescheduleToken String?           @unique
  cancelToken     String?           @unique
  reminderSentAt  DateTime?
  bookedVia       String?

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner       User?        @relation("AppointmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  actionItems ActionItem[]

  @@index([leadId])
  @@index([scheduledAt])
  @@index([eventTypeId])
}

enum ActionItemStatus {
  OPEN
  DONE
}

enum ActionItemSource {
  MANUAL
  FIREFLIES
}

model ActionItem {
  id            String           @id @default(cuid())
  appointmentId String?
  leadId        String?
  assigneeId    String?
  description   String
  dueDate       DateTime?
  status        ActionItemStatus @default(OPEN)
  source        ActionItemSource @default(MANUAL)
  createdAt     DateTime         @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  WON
  LOST
}

enum PaymentScheduleType {
  ONE_TIME
  DEPOSIT_THEN_BALANCE
  INSTALLMENTS
  RECURRING
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
}

enum StaffLevel {
  ASSOCIATE
  SENIOR
  MANAGER
  DIRECTOR
  PARTNER
}

// Firm-wide standard rate card (one row per level). Scoping cards default their
// per-level cost/bill rates from here.
model RateCardLevel {
  level     StaffLevel @id
  cost      Decimal    @db.Decimal(12, 2)
  bill      Decimal    @db.Decimal(12, 2)
  sortOrder Int        @default(0)
}

model Proposal {
  id                   String         @id @default(cuid())
  hubspotId            String?        @unique
  leadId               String
  ownerId              String?
  title                String
  status               ProposalStatus @default(DRAFT)
  estimatedDeliveryCost Decimal       @default(0) @db.Decimal(12, 2)
  createdAt            DateTime       @default(now())
  sentAt              DateTime?
  viewedAt            DateTime?
  signedAt            DateTime?
  wonAt               DateTime?
  lostAt              DateTime?
  lostReason          String?

  // Client-facing document content (shown on the public proposal page)
  coverLetter    String? @db.Text
  scopeNarrative String? @db.Text
  termsText      String? @db.Text

  // Public share + e-signature capability + audit trail
  publicToken      String? @unique
  signerName       String?
  signerEmail      String?
  signedIp         String?
  signedUserAgent  String?

  // Payment schedule (stored + displayed now; collection wired in a later phase)
  paymentScheduleType PaymentScheduleType @default(ONE_TIME)
  recurringInterval   String?

  // Stripe deposit collection at signing
  paymentStatus         PaymentStatus @default(NONE)
  amountPaid            Decimal?      @db.Decimal(12, 2)
  paidAt                DateTime?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?

  // Scoping engine: sales-value markup on top of standard budget revenue
  salesMarkupEnabled Boolean @default(false)
  salesMarkupPct     Decimal @default(0) @db.Decimal(6, 2)

  // Demo deliverables shown to the client (gate: at least one required to send)
  demoKeys String[] @default([])

  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner        User?              @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lineItems    ProposalLineItem[]
  payments     ProposalPayment[]
  scopingLines ScopingLine[]
  handoff      Handoff?

  @@index([leadId])
  @@index([status])
}

// Per-proposal scoping: estimated hours per staff level with the cost/bill rates
// (snapshot-defaulted from the firm rate card, overridable per deal).
model ScopingLine {
  id         String     @id @default(cuid())
  proposalId String
  level      StaffLevel
  hours      Decimal    @default(0) @db.Decimal(10, 2)
  costRate   Decimal    @default(0) @db.Decimal(12, 2)
  billRate   Decimal    @default(0) @db.Decimal(12, 2)
  sortOrder  Int        @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, level])
  @@index([proposalId])
}

model ProposalPayment {
  id          String  @id @default(cuid())
  proposalId  String
  description String
  amount      Decimal @default(0) @db.Decimal(12, 2)
  dueOn       String?
  sortOrder   Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// Reusable proposal templates (agent- and human-selectable). A full template
// prefills every proposal section + line items + payment schedule in one apply.
model ProposalTemplate {
  id                  String              @id @default(cuid())
  key                 String              @unique
  name                String
  description         String?
  defaultTitle        String
  coverLetter         String?             @db.Text
  scopeNarrative      String?             @db.Text
  termsText           String?             @db.Text
  paymentScheduleType PaymentScheduleType @default(ONE_TIME)
  recurringInterval   String?
  defaultDeliveryCost Decimal?            @db.Decimal(12, 2)
  demoKey             String?
  lineItems           Json // [{ description, quantity, unitPrice }]
  payments            Json // [{ description, amount, dueOn }]
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
}

enum SnippetType {
  COVER
  SCOPE
  TERMS
}

// Per-section reusable snippets that fill a single proposal section.
model SectionSnippet {
  id        String      @id @default(cuid())
  key       String      @unique
  type      SnippetType
  name      String
  body      String      @db.Text
  sortOrder Int         @default(0)

  @@index([type])
}

// Firm-level demo library: anonymized SAMPLE deliverables per service line,
// shown to the client so no proposal goes out without an artifact of the work.
model DemoTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  serviceLine   String
  name          String
  title         String
  subtitle      String?
  metrics       Json // [{ label, value, hint }]
  tables        Json // [{ title, columns:[...], rows:[[...]] }]
  narrative     String?  @db.Text
  isPlaceholder Boolean  @default(true)
  sortOrder     Int      @default(0)
}

// Firm-level brochure / social proof shown on the client proposal page. Single
// row (id "default"). Content is JSON so agents/humans can edit freely.
// isPlaceholder stays true until real content is set — the client page shows a
// "sample content" banner while true so example stats never look real.
model Brochure {
  id            String   @id @default("default")
  headline      String?
  intro         String?  @db.Text
  stats         Json // [{ value, label }]
  caseStudies   Json // [{ service, title, result, detail }]
  testimonials  Json // [{ quote, author, role }]
  linkedinPosts Json // [{ excerpt, url }]
  isPlaceholder Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model ProposalLineItem {
  id          String  @id @default(cuid())
  proposalId  String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

model Handoff {
  id             String         @id @default(cuid())
  proposalId     String         @unique
  deliveryStatus DeliveryStatus @default(PENDING)
  assignedTo     String?
  createdAt      DateTime       @default(now())

  proposal  Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  checklist ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  handoffId   String
  label       String
  done        Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)

  handoff Handoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([handoffId])
}

// ============================================================================
// ECHO — trust & authority content engine (Phase 1: Evidence + Calling Cards)
// Evidence -> Calling Cards -> (Housed Content -> Optics) -> LAPS handoff.
// ============================================================================

// Shared taxonomy across ECHO + LAPS + Quality of Exit — the eight QoO pillars.
enum QoOPillar {
  EARNINGS
  CASH_FLOW
  REPORTING
  GROWTH
  TAXATION
  CAPITAL
  LIFESTYLE
  VALUATION
}

enum EvidenceType {
  PAIN_POINT
  OBJECTION
  MYTH
  PRIZE_STATE
  CLIENT_STORY
  METHODOLOGY
  QUOTE
  DATA_POINT
}

enum EvidenceSource {
  SALES_CALL
  CLIENT_ENGAGEMENT
  FIREFLIES_TRANSCRIPT
  EMAIL
  MANUAL
}

enum Consent {
  INTERNAL_ONLY
  ANONYMIZED
  PUBLIC
}

enum CardCategory {
  HOOK
  REFRAME
  MANTRA
  OBJECTION_KILL
  PRIZE_FRAME
  MECHANISM_NAME
}

enum CardStatus {
  CANDIDATE
  ACTIVE
  RETIRED
}

// E — Evidence: the vault. Real, resonant material from calls/engagements.
model EvidenceRecord {
  id         String         @id @default(cuid())
  type       EvidenceType
  source     EvidenceSource @default(MANUAL)
  sourceRef  String?
  rawText    String         @db.Text
  distilled  String?        @db.Text
  clientRef  String? // internal only — never published
  consent    Consent        @default(INTERNAL_ONLY)
  pillarTags QoOPillar[]
  icpFit     Boolean        @default(false)
  icpNotes   String?
  strength   Int            @default(3) // 1-5, how vivid/provable
  usedCount  Int            @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())

  cards        CallingCard[]  @relation("CardEvidence")
  contentItems ContentItem[]  @relation("ContentEvidence")

  @@index([type])
  @@index([source])
}

// Named frameworks (QoO pillars, Quality of Exit, deal cases) — versioned markdown.
model MethodologyDoc {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  version    Int         @default(1)
  body       String      @db.Text
  pillarTags QoOPillar[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// C — Calling Cards: the repeatable, ownable language bank.
model CallingCard {
  id               String       @id @default(cuid())
  cardText         String       @db.Text
  category         CardCategory
  pillarTags       QoOPillar[]
  status           CardStatus   @default(CANDIDATE)
  usageCount       Int          @default(0)
  performanceIndex Float        @default(0)
  createdAt        DateTime     @default(now())

  evidence     EvidenceRecord[] @relation("CardEvidence")
  contentItems ContentItem[]    @relation("ContentCards")

  @@index([status])
}

// ── H — Housed Content: the content builder + repurposing engine ──────────
enum ContentChannel {
  LINKEDIN
  X
  EMAIL
  NEWSLETTER
  BLOG
  YOUTUBE
  PODCAST
  WEBSITE
  BOOK
  OTHER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ModuleKind {
  BOOK
  CAMPAIGN
  SERIES
  COURSE
  OTHER
}

// A grouping of content items — a book (chapters), a campaign, a series.
model ContentModule {
  id          String     @id @default(cuid())
  name        String
  kind        ModuleKind @default(CAMPAIGN)
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items ContentItem[]
}

// A single piece of content. Every item should trace back to evidence.
model ContentItem {
  id        String         @id @default(cuid())
  title     String
  channel   ContentChannel @default(LINKEDIN)
  status    ContentStatus  @default(DRAFT)
  format    String?
  summary   String?        @db.Text
  body      String         @db.Text @default("")
  pillarTags QoOPillar[]

  moduleId  String?
  module    ContentModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  sortOrder Int            @default(0)

  // Repurposing: this item was derived from a source item.
  sourceItemId String?
  sourceItem   ContentItem?  @relation("Repurpose", fields: [sourceItemId], references: [id], onDelete: SetNull)
  derivatives  ContentItem[] @relation("Repurpose")

  evidence EvidenceRecord[] @relation("ContentEvidence")
  cards    CallingCard[]    @relation("ContentCards")
  metrics  MetricSnapshot[]

  publishedUrl String?
  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([channel])
  @@index([moduleId])
}

// ── O — Optics: how content performed once published ──────────────────────
// Manually aggregated for now (no analytics connector). Each snapshot is a
// point-in-time reading of a piece's numbers; resonance is derived.
model MetricSnapshot {
  id            String          @id @default(cuid())
  contentItemId String?
  contentItem   ContentItem?    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel       ContentChannel?
  capturedAt    DateTime        @default(now())
  impressions   Int             @default(0)
  engagements   Int             @default(0)
  clicks        Int             @default(0)
  conversions   Int             @default(0)
  note          String?
  source        String?
  createdAt     DateTime        @default(now())

  @@index([contentItemId])
  @@index([capturedAt])
}

// Hard guardrail: phrases that fail draft/card validation on sight.
model BannedPhrase {
  id        String   @id @default(cuid())
  phrase    String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// ── ECHO → LAPS handoff: per-lead trust score ─────────────────────────────
// Trust is earned in ECHO (content engagement) and converted in LAPS. Each
// signal is a weighted engagement event; Lead.trustScore caches the rollup so
// the pipeline and lead lists stay cheap to render.
enum TrustSignalKind {
  CONTENT_VIEW
  CONTENT_ENGAGE
  EMAIL_REPLY
  MEETING_ATTENDED
  WEBINAR
  DOWNLOAD
  REFERRAL
  INBOUND_INQUIRY
  MANUAL
}

model TrustSignal {
  id         String          @id @default(cuid())
  leadId     String
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       TrustSignalKind
  weight     Int
  note       String?
  contentRef String?
  source     String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  @@index([leadId])
}

// ── Scheduling — self-serve booking (Calendly-style) ──────────────────────
enum BookingLocationType {
  ZOOM
  PHONE
  IN_PERSON
  CUSTOM
}

// One per host user: their public booking identity + default availability.
model BookingHost {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  displayName String?
  welcome     String?  @db.Text
  timezone    String   @default("America/New_York")
  zoomLink    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventTypes BookingEventType[]
  rules      AvailabilityRule[]
  overrides  AvailabilityOverride[]
}

// Weekly recurring availability window (minutes-from-midnight, host timezone).
model AvailabilityRule {
  id       String      @id @default(cuid())
  hostId   String
  host     BookingHost @relation(fields: [hostId], references: [id], onDelete: Cascade)
  weekday  Int // 0=Sunday .. 6=Saturday
  startMin Int
  endMin   Int

  @@index([hostId])
}

// Per-date exception: blackout (available=false) or custom hours (available=true).
model AvailabilityOverride {
  id        String      @id @default(cuid())
  hostId    String
  host      BookingHost @relation(fields: [hostId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  available Boolean     @default(false)
  startMin  Int?
  endMin    Int?

  @@unique([hostId, date])
}

// A bookable meeting type (duration, location, rules, screening questions).
model BookingEventType {
  id              String              @id @default(cuid())
  hostId          String
  host            BookingHost         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  description     String?             @db.Text
  durationMin     Int                 @default(30)
  locationType    BookingLocationType @default(ZOOM)
  location        String? // overrides host zoomLink when set
  bufferBeforeMin Int                 @default(0)
  bufferAfterMin  Int                 @default(0)
  minNoticeMin    Int                 @default(240)
  rollingDays     Int                 @default(60)
  maxPerDay       Int?
  color           String?
  active          Boolean             @default(true)
  questions       Json                @default("[]") // [{id,label,type,required}]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  appointments Appointment[]

  @@unique([hostId, slug])
  @@index([hostId])
}
