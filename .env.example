# ---- Database (Neon / Postgres) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js (NextAuth) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# App base URL (used for OAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ---- Microsoft Entra ID (M365) ----
# From the Azure app registration. Delegated scopes: Mail.Send, Mail.Read, Calendars.Read, User.Read, offline_access
AUTH_MICROSOFT_ENTRA_ID_ID="your-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"

# ---- Dev login fallback ----
# When "true", enables password-less sign-in as any seeded user (LOCAL DEV ONLY).
ALLOW_DEV_LOGIN="true"

# ---- Stripe (deposit collection at signing) ----
# Server secret key (use a test key sk_test_… first). When unset, proposals
# sign without collecting a deposit.
# STRIPE_SECRET_KEY=""
# Signing secret for the Stripe webhook endpoint (whsec_…). Optional — the
# success-return confirmation works without it, but the webhook is the reliable
# backstop when a client pays then closes the tab.
# STRIPE_WEBHOOK_SECRET=""

# ---- Agent HTTP API ----
# Bearer token for /api/agent/* so an agent can create/fill/send proposals.
# Generate a strong random value; unset disables the API (503).
# AGENT_API_KEY=""

# ---- Embedded chat assistant (Anthropic) ----
# API key for the in-app LAPS assistant (chat widget). When unset, the assistant
# shows "not configured" and /api/agent/chat returns 503.
# ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-5).
# ANTHROPIC_AGENT_MODEL="claude-opus-5"

# ---- STAPLE: file storage (S3-compatible object store) ----
# Delivery FileAssets. Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# When unset, STAPLE runs on file *metadata* only (upload disabled); set these
# to enable real uploads + client upload links.
# STAPLE_S3_BUCKET=""
# STAPLE_S3_REGION="us-east-1"
# STAPLE_S3_ACCESS_KEY_ID=""
# STAPLE_S3_SECRET_ACCESS_KEY=""
# Optional endpoint for non-AWS stores (e.g. R2/B2/MinIO). Leave blank for AWS.
# STAPLE_S3_ENDPOINT=""

# ---- ECHO: Fireflies (evidence feed) ----
# API key from Fireflies (Settings → Developer). When unset, ECHO's Fireflies
# import shows "not connected"; manual evidence entry still works.
# FIREFLIES_API_KEY=""

# ---- Scheduling (booking pages) ----
# Public base URL used in booking confirmation/reminder links (falls back to
# NEXTAUTH_URL, then the request host).
# NEXT_PUBLIC_APP_URL=""
# Shared secret guarding the reminder cron endpoint (/api/cron/booking-reminders).
# CRON_SECRET=""

# ---- PACE: QuickBooks Online (Actuals) ----
# From an Intuit developer app. When unset, PACE runs on manual/CSV trial-balance
# import; set these to enable per-entity QBO connect + nightly sync.
# QBO_CLIENT_ID=""
# QBO_CLIENT_SECRET=""
# "sandbox" (default) or "production".
# QBO_ENVIRONMENT="sandbox"
# OAuth redirect (must match the Intuit app config). Defaults to
# <APP_URL>/api/pace/qbo/callback.
# QBO_REDIRECT_URI=""

